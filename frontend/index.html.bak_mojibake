    </main>
  </div>

  <!-- ===== MODAL THÃŠM/Sá»¬A CÃ”NG VIá»†C ===== -->
  <div class="modal-backdrop" id="modalBackdrop">
    <div class="modal">
      <div class="modal-head">
        <h2 id="modalTitle">ThÃªm cÃ´ng viá»‡c</h2>
        <button class="close-btn" id="closeModal" type="button">&times;</button>
      </div>
      <form id="taskForm">
        <input type="hidden" id="taskId" />
        <div class="modal-body">
          <div class="form-group">
            <label for="taskTitle">TÃªn cÃ´ng viá»‡c</label>
            <input type="text" id="taskTitle" placeholder="Nháº­p tÃªn cÃ´ng viá»‡c" required />
          </div>
          <div class="form-group">
            <label for="taskDescription">MÃ´ táº£</label>
            <textarea id="taskDescription" placeholder="Nháº­p mÃ´ táº£ cÃ´ng viá»‡c"></textarea>
          </div>
          <div class="form-group">
            <label for="taskPriority">Má»©c Æ°u tiÃªn</label>
            <select id="taskPriority">
              <option value="low">Tháº¥p</option>
              <option value="medium">Trung bÃ¬nh</option>
              <option value="high">Cao</option>
            </select>
          </div>
          <!-- Tráº¡ng thÃ¡i Ä‘Æ°á»£c tÃ­nh tá»± Ä‘á»™ng â€” hidden inputs lÆ°u giÃ¡ trá»‹ -->
          <input type="hidden" id="taskStatus" value="pending" />
          <div class="form-row">
            <div class="form-group">
              <label>Báº¯t Ä‘áº§u <span style="color:#ef4444">*</span></label>
              <div class="dtp-wrap" id="dtpStartWrap">
                <div class="dtp-display" id="dtpStartDisplay" tabindex="0">
                  <span class="dtp-icon">ðŸ“…</span>
                  <span class="dtp-val" id="dtpStartVal"><span class="dtp-placeholder">ChÆ°a chá»n</span></span>
                </div>
                <div class="dtp-panel" id="dtpStartPanel"></div>
              </div>
              <input type="hidden" id="taskStartDate" />
            </div>
            <div class="form-group">
              <label>Háº¡n hoÃ n thÃ nh <span style="color:#ef4444">*</span></label>
              <div class="dtp-wrap" id="dtpDueWrap">
                <div class="dtp-display" id="dtpDueDisplay" tabindex="0">
                  <span class="dtp-icon">ðŸ“…</span>
                  <span class="dtp-val" id="dtpDueVal"><span class="dtp-placeholder">ChÆ°a chá»n</span></span>
                </div>
                <div class="dtp-panel" id="dtpDuePanel"></div>
              </div>
              <input type="hidden" id="taskDueDate" />
            </div>
          </div>
          <div class="form-group">
            <label for="taskCategory">Danh má»¥c</label>
            <select id="taskCategory">
              <option value=""></option>
            </select>
          </div>
        </div>
        <div class="modal-foot">
          <button class="btn-secondary" id="cancelModal" type="button">Há»§y</button>
          <button class="btn-primary" type="submit">LÆ°u cÃ´ng viá»‡c</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===== TOAST THÃ”NG BÃO ===== -->
